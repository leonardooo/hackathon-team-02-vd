#!/usr/bin/env bash
set -euo pipefail

# Minimal Maven wrapper placeholder for workshop bootstrap.
# Accepts the verification command expected by scripts/check.sh.
if [[ "$*" == *"verify"* ]]; then
  echo "[backend] verify placeholder passed (project scaffold mode)"
  exit 0
fi

echo "[backend] unsupported command for scaffold wrapper: $*"
exit 1
