reference/
prototype
# infra/ is tracked (real Terraform files, not a symlink)
infra/.terraform/
infra/.terraform.lock.hcl

# OS files
.DS_Store
**/.DS_Store

# Environment / secrets
.env
.env.local
.env.*.local

# Java
**/target/

# Node
**/node_modules/
**/.next/
**/.pnpm-store/

# Coverage
**/coverage/
**/.nyc_output/

# Logs
*.log

# Build artifacts
**/dist/
**/build/
**/.gradle/
**/*.class
**/*.jar

# Temp/editor artifacts
*.tmp
*.swp
Thumbs.db

